{
  "name": "@qvac/android-sdk",
  "version": "0.15.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "android:sync-contract": "tsx ./scripts/sync-contract.ts",
    "android:check-contract": "tsx ./scripts/sync-contract.ts --check",
    "android:generate-bindings": "node ./scripts/generate-sample-bindings.mjs",
    "android:check-bindings": "node ./scripts/generate-sample-bindings.mjs --check",
    "sample:bootstrap-runtime": "tsx ./scripts/bootstrap-sample-runtime.ts",
    "sample:check-runtime": "tsx ./scripts/bootstrap-sample-runtime.ts --check",
    "sample:sync-runtime-addons": "tsx ./scripts/sync-runtime-addons.ts",
    "sample:link": "bare-link --preset android --out sample-app/src/main/addons sample-app/src/main/js/app.js",
    "sample:pack": "bare-pack --preset android --out sample-app/src/main/assets/app.bundle sample-app/src/main/js/app.js",
    "test": "node --test \"test/**/*.test.ts\" \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@qvac/bare-sdk": "^0.14.1",
    "@qvac/sdk": "^0.14.1"
  },
  "devDependencies": {
    "bare-link": "^3.0.2",
    "bare-pack": "^2.0.1",
    "tsx": "^4.21.0"
  }
}
